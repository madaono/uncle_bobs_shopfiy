{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers (not shown in this example).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

<div class="article-container">
  <div class="article-content">
    <!-- Article Header -->
    <header class="article-header">
      {% if article.image %}
        <div class="article-image">
          {{ article.image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'article-image__img' }}
        </div>
      {% endif %}
      
      <h1 class="article-title">{{ article.title }}</h1>
      
      <div class="article-meta">
        {% assign date = article.published_at | time_tag: format: 'date' %}
        <div class="article-meta__item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <time class="article-meta__date">{{ date }}</time>
        </div>
        {% if article.author != blank %}
          <div class="article-meta__item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <span class="article-meta__author">{{ article.author }}</span>
          </div>
        {% endif %}
      </div>
    </header>

    <!-- Article Body -->
    <div class="article-body">
      {{ article.content }}
    </div>
  </div>
</div>

{% if blog.comments_enabled? %}
  <h2>{{ 'blog.article_comments' | t }}</h2>

  <div id="comments">
    {% paginate article.comments by 10 %}
      {% for comment in article.comments %}
        <div>
          <p>{{ comment.author }}</p>
          <p>
            {{- comment.created_at | time_tag: format: 'date' -}}
          </p>
          <p>{{ comment.content }}</p>
        </div>
      {% endfor %}

      {{ paginate | default_pagination: anchor: 'comments' }}
    {% endpaginate %}
  </div>

  {% form 'new_comment', article %}
    <h2>{{ 'blog.comment_form_title' | t }}</h2>

    {{ form.errors | default_errors }}

    <div>
      <label for="author">{{ 'blog.comment_form_name' | t }}</label>
      <input type="text" name="comment[author]" id="author" value="{{ form.author }}" required>
    </div>

    <div>
      <label for="email">{{ 'blog.comment_form_email' | t }}</label>
      <input type="email" name="comment[email]" id="email" value="{{ form.email }}" required>
    </div>

    <div>
      <label for="body">{{ 'blog.comment_form_body' | t }}</label>
      <textarea name="comment[body]" id="body" required>{{ form.body }}</textarea>
    </div>

    <input type="submit" value="{{ 'blog.comment_form_submit' | t }}">
  {% endform %}
{% endif %}

{% stylesheet %}
.article-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.article-content {
  max-width: 800px;
  margin: 0 auto;
  padding: 3rem 0;
}

.article-header {
  margin-bottom: 3rem;
}

.article-image {
  width: 100%;
  height: 500px;
  max-height: 500px;
  margin-bottom: 2rem;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.article-image__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
}

.article-title {
  font-size: 2.5rem;
  font-weight: 700;
  color: #1A2B40;
  margin: 0 0 1.5rem 0;
  line-height: 1.3;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  color: #666;
  font-size: 0.95rem;
}

.article-meta__item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.article-meta__item svg {
  color: #999;
}

.article-meta__date,
.article-meta__author {
  color: #666;
}

.article-body {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #333;
}

.article-body h1,
.article-body h2,
.article-body h3,
.article-body h4,
.article-body h5,
.article-body h6 {
  margin-top: 2rem;
  margin-bottom: 1rem;
  color: #1A2B40;
  font-weight: 600;
}

.article-body h2 {
  font-size: 1.8rem;
}

.article-body h3 {
  font-size: 1.5rem;
}

.article-body p {
  margin-bottom: 1.5rem;
}

.article-body a {
  color: #2c5f8d;
  text-decoration: underline;
  transition: color 0.2s ease;
}

.article-body a:hover {
  color: #1A2B40;
}

.article-body img {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  margin: 2rem 0;
}

.article-body ul,
.article-body ol {
  margin: 1.5rem 0;
  padding-left: 2rem;
}

.article-body li {
  margin-bottom: 0.75rem;
}

.article-body blockquote {
  border-left: 4px solid #1A2B40;
  padding-left: 1.5rem;
  margin: 2rem 0;
  font-style: italic;
  color: #666;
}

.article-body code {
  background: #f5f5f5;
  padding: 0.2rem 0.4rem;
  border-radius: 4px;
  font-family: 'Courier New', monospace;
  font-size: 0.9em;
}

.article-body pre {
  background: #1A2B40;
  color: white;
  padding: 1.5rem;
  border-radius: 8px;
  overflow-x: auto;
  margin: 2rem 0;
}

.article-body pre code {
  background: transparent;
  color: white;
  padding: 0;
}

.article-body hr {
  border: none;
  border-top: 2px solid #e9ecef;
  margin: 3rem 0;
}

/* Responsive Styles */
@media (max-width: 768px) {
  .article-container {
    padding: 0 1rem;
  }

  .article-content {
    padding: 2rem 0;
  }

  .article-image {
    height: 300px;
    max-height: 300px;
    margin-bottom: 1.5rem;
    border-radius: 8px;
  }

  .article-title {
    font-size: 2rem;
  }

  .article-meta {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .article-body {
    font-size: 1rem;
  }

  .article-body h2 {
    font-size: 1.5rem;
  }

  .article-body h3 {
    font-size: 1.25rem;
  }
}

@media (max-width: 480px) {
  .article-container {
    padding: 0 0.75rem;
  }

  .article-content {
    padding: 1.5rem 0;
  }

  .article-image {
    height: 200px;
    max-height: 200px;
  }

  .article-title {
    font-size: 1.75rem;
  }

  .article-body {
    font-size: 0.95rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": []
}
{% endschema %}
