{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<div class="blog-container">
  <div class="blog-header">
    <h1 class="blog-title">{{ blog.title }}</h1>
    {% if blog.description != blank %}
      <p class="blog-description">{{ blog.description }}</p>
    {% endif %}
  </div>

  <div class="blog-grid">
    {% paginate blog.articles by 12 %}
      {% for article in blog.articles %}
        <article class="blog-card">
          <a href="{{ article.url }}" class="blog-card__link">
            <div class="blog-card__image-wrapper">
              {% if article.image %}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'blog-card__image' }}
              {% else %}
                <div class="blog-card__placeholder">
                  <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </div>
              {% endif %}
            </div>
            
            <div class="blog-card__content">
              <div class="blog-card__meta">
                {% assign date = article.published_at | time_tag: format: 'date' %}
                <time class="blog-card__date">{{ date }}</time>
                {% if article.author != blank %}
                  <span class="blog-card__separator">•</span>
                  <span class="blog-card__author">{{ article.author }}</span>
                {% endif %}
              </div>
              
              <h2 class="blog-card__title">{{ article.title }}</h2>
              
              {% if article.excerpt != blank %}
                <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
              {% endif %}
              
              <span class="blog-card__read-more">Read More →</span>
            </div>
          </a>
        </article>
      {% endfor %}
    {% endpaginate %}
  </div>

  {%- if paginate.pages > 1 -%}
    <div class="blog-pagination">
      {{- paginate | default_pagination: paginate -}}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.blog-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 3rem 2rem;
}

.blog-header {
  text-align: center;
  margin-bottom: 3rem;
}

.blog-title {
  font-size: 2.5rem;
  font-weight: 700;
  color: #1A2B40;
  margin: 0 0 1rem 0;
}

.blog-description {
  font-size: 1.1rem;
  color: #666;
  margin: 0;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
}

.blog-card {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.blog-card:hover {
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  transform: translateY(-4px);
}

.blog-card__link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.blog-card__image-wrapper {
  width: 100%;
  height: 240px;
  overflow: hidden;
  background: #f5f5f5;
  position: relative;
}

.blog-card__image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  transition: transform 0.3s ease;
}

.blog-card:hover .blog-card__image {
  transform: scale(1.05);
}

.blog-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  color: #ccc;
}

.blog-card__content {
  padding: 1.5rem;
}

.blog-card__meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: #666;
  margin-bottom: 0.75rem;
}

.blog-card__separator {
  color: #ccc;
}

.blog-card__date,
.blog-card__author {
  color: #666;
}

.blog-card__title {
  font-size: 1.25rem;
  font-weight: 600;
  color: #1A2B40;
  margin: 0 0 0.75rem 0;
  line-height: 1.4;
  transition: color 0.2s ease;
}

.blog-card:hover .blog-card__title {
  color: #2c5f8d;
}

.blog-card__excerpt {
  font-size: 0.95rem;
  color: #666;
  line-height: 1.6;
  margin: 0 0 1rem 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.blog-card__read-more {
  display: inline-block;
  font-size: 0.9rem;
  font-weight: 600;
  color: #1A2B40;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: all 0.2s ease;
}

.blog-card:hover .blog-card__read-more {
  color: #2c5f8d;
  transform: translateX(4px);
}

.blog-pagination {
  margin-top: 3rem;
  text-align: center;
}

.blog-pagination .pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.5rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.blog-pagination .pagination__item {
  display: inline-block;
}

.blog-pagination .pagination__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 1rem;
  background: white;
  border: 2px solid #e9ecef;
  border-radius: 8px;
  color: #1A2B40;
  text-decoration: none;
  font-weight: 600;
  transition: all 0.2s ease;
  min-width: 40px;
}

.blog-pagination .pagination__link:hover {
  background: #1A2B40;
  color: white;
  border-color: #1A2B40;
}

.blog-pagination .pagination__item.is-active .pagination__link {
  background: #1A2B40;
  color: white;
  border-color: #1A2B40;
}

/* Responsive Styles */
@media (max-width: 768px) {
  .blog-container {
    padding: 2rem 1rem;
  }

  .blog-title {
    font-size: 2rem;
  }

  .blog-description {
    font-size: 1rem;
  }

  .blog-grid {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .blog-card__image-wrapper {
    height: 200px;
  }

  .blog-card__content {
    padding: 1.25rem;
  }

  .blog-card__title {
    font-size: 1.1rem;
  }

  .blog-card__excerpt {
    font-size: 0.875rem;
  }
}

@media (max-width: 480px) {
  .blog-container {
    padding: 1.5rem 1rem;
  }

  .blog-title {
    font-size: 1.75rem;
  }

  .blog-grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .blog-card__image-wrapper {
    height: 180px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
