{% comment %}
  Uncle Bob's Shopping Cart Page
{% endcomment %}

<div class="cart-page">
  <div class="cart-header">
    <h1 class="cart-title">{{ 'cart.title' | t }}</h1>
    {% if cart.item_count == 0 %}
      <p class="cart-empty-message">{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.collections_url }}" class="btn btn-primary">{{ 'cart.continue_shopping' | t }}</a>
    {% endif %}
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item">
            <div class="cart-item__image">
              {% if item.image %}
                {% render 'image', image: item.image, url: item.url, width: 120, height: 120 %}
              {% else %}
                <div class="cart-item__placeholder">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21,15 16,10 5,21"/>
                  </svg>
                </div>
              {% endif %}
            </div>

            <div class="cart-item__details">
              <h3 class="cart-item__title">
                <a href="{{ item.url }}">{{ item.product.title }}</a>
              </h3>
              {% if item.variant.title != 'Default Title' %}
                <p class="cart-item__variant">{{ item.variant.title }}</p>
              {% endif %}
              <div class="cart-item__price">
                {{ item.price | money }}
                {% if item.original_price != item.price %}
                  <span class="cart-item__original-price">{{ item.original_price | money }}</span>
                {% endif %}
              </div>
            </div>

            <div class="cart-item__quantity">
              <label for="quantity-{{ forloop.index }}" class="quantity-label">Quantity:</label>
              <div class="quantity-controls">
                <button type="button" class="quantity-btn quantity-decrease" data-item-key="{{ item.key }}">-</button>
                <input type="number" 
                       id="quantity-{{ forloop.index }}" 
                       name="updates[]" 
                       value="{{ item.quantity }}" 
                       min="0" 
                       class="quantity-input"
                       data-item-key="{{ item.key }}">
                <button type="button" class="quantity-btn quantity-increase" data-item-key="{{ item.key }}">+</button>
              </div>
            </div>

            <div class="cart-item__total">
              <span class="cart-item__total-label">Total:</span>
              <span class="cart-item__total-price">{{ item.line_price | money }}</span>
            </div>

            <div class="cart-item__remove">
              <a href="{{ item.url_to_remove }}" class="remove-link" aria-label="Remove {{ item.product.title }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3,6 5,6 21,6"/>
                  <path d="M19,6v14a2,2 0 0,1 -2,2H7a2,2 0 0,1 -2,-2V6m3,0V4a2,2 0 0,1 2,-2h4a2,2 0 0,1 2,2v2"/>
                </svg>
                {{ 'cart.remove' | t }}
              </a>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-summary">
        <div class="cart-totals">
          <div class="cart-subtotal">
            <span class="cart-subtotal-label">Subtotal:</span>
            <span class="cart-subtotal-price">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-note">Shipping and taxes calculated at checkout</p>
        </div>

        <div class="cart-actions">
          <button type="submit" name="update" class="btn btn-secondary">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn-primary">{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {% endif %}
</div>

{% stylesheet %}
  .cart-page {
    padding: 2rem 0 4rem;
    background-color: var(--brand-background);
  }

  .cart-header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 0 var(--page-margin);
  }

  .cart-title {
    font-size: 2.5rem;
    color: var(--brand-text);
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .cart-empty-message {
    font-size: 1.2rem;
    color: var(--brand-text-muted);
    margin-bottom: 2rem;
  }

  .cart-form {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 120px 1fr auto auto auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
    background-color: var(--brand-background);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0, 102, 204, 0.1);
    transition: all 0.3s ease;
  }

  .cart-item:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--brand-primary);
  }

  .cart-item__image {
    width: 120px;
    height: 120px;
    border-radius: var(--border-radius);
    overflow: hidden;
    background-color: var(--brand-surface);
  }

  .cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-primary);
    background-color: var(--brand-surface);
  }

  .cart-item__details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart-item__title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--brand-text);
    margin: 0;
  }

  .cart-item__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .cart-item__title a:hover {
    color: var(--brand-primary);
  }

  .cart-item__variant {
    font-size: 0.9rem;
    color: var(--brand-text-muted);
    margin: 0;
  }

  .cart-item__price {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--brand-primary);
  }

  .cart-item__original-price {
    font-size: 0.9rem;
    color: var(--brand-text-muted);
    text-decoration: line-through;
    margin-left: 0.5rem;
  }

  .cart-item__quantity {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
  }

  .quantity-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--brand-text);
  }

  .quantity-controls {
    display: flex;
    align-items: center;
    border: 2px solid rgba(0, 102, 204, 0.2);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .quantity-btn {
    width: 32px;
    height: 32px;
    border: none;
    background-color: var(--brand-surface);
    color: var(--brand-text);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quantity-btn:hover {
    background-color: var(--brand-primary);
    color: var(--brand-background);
  }

  .quantity-input {
    width: 50px;
    height: 32px;
    border: none;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    background-color: var(--brand-background);
    color: var(--brand-text);
  }

  .quantity-input:focus {
    outline: none;
  }

  .cart-item__total {
    text-align: center;
    min-width: 100px;
  }

  .cart-item__total-label {
    display: block;
    font-size: 0.9rem;
    color: var(--brand-text-muted);
    margin-bottom: 0.25rem;
  }

  .cart-item__total-price {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--brand-primary);
  }

  .cart-item__remove {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .remove-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--brand-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .remove-link:hover {
    color: #dc3545;
  }

  .cart-summary {
    background-color: var(--brand-surface);
    padding: 2rem;
    border-radius: var(--border-radius-lg);
    border: 1px solid rgba(0, 102, 204, 0.1);
  }

  .cart-totals {
    margin-bottom: 2rem;
  }

  .cart-subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(0, 102, 204, 0.1);
    margin-bottom: 1rem;
  }

  .cart-subtotal-label {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--brand-text);
  }

  .cart-subtotal-price {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-primary);
  }

  .cart-note {
    font-size: 0.9rem;
    color: var(--brand-text-muted);
    margin: 0;
    text-align: center;
  }

  .cart-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .cart-actions .btn {
    flex: 1;
    max-width: 200px;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .cart-title {
      font-size: 2rem;
    }

    .cart-item {
      grid-template-columns: 80px 1fr;
      gap: 1rem;
      padding: 1rem;
    }

    .cart-item__image {
      width: 80px;
      height: 80px;
    }

    .cart-item__quantity,
    .cart-item__total,
    .cart-item__remove {
      grid-column: 1 / -1;
      justify-self: center;
      margin-top: 1rem;
    }

    .cart-item__quantity {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }

    .cart-item__total {
      text-align: left;
    }

    .cart-actions {
      flex-direction: column;
    }

    .cart-actions .btn {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .cart-item {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .cart-item__image {
      justify-self: center;
    }

    .cart-item__details {
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
