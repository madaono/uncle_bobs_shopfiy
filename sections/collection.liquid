{% comment %}
  Uncle Bob's Collection Products Page
{% endcomment %}

<div class="collection-page">
  <div class="collection-header">
    <h1 class="collection-title">{{ collection.title }}</h1>
    {% if collection.description %}
      <div class="collection-description">
        {{ collection.description }}
      </div>
    {% endif %}
    <div class="collection-meta">
      <span class="collection-count">{{ collection.products_count }} Products</span>
    </div>
  </div>

  <div class="collection-products">
    {% paginate collection.products by 20 %}
      <div class="products-grid">
        {% for product in collection.products %}
          <div class="product-card">
            <a href="{{ product.url }}" class="product-card__link">
              <div class="product-card__image-container">
                {% if product.featured_image %}
                  {% render 'image',
                    class: 'product-card__image',
                    image: product.featured_image,
                    width: 400,
                    height: 400,
                    crop: 'center'
                  %}
                {% else %}
                  <div class="product-card__placeholder">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21,15 16,10 5,21"/>
                    </svg>
                  </div>
                {% endif %}
                {% if product.compare_at_price > product.price %}
                  <div class="product-card__badge">Sale</div>
                {% endif %}
              </div>

              <div class="product-card__content">
                <h3 class="product-card__title">{{ product.title | escape }}</h3>
                <div class="product-card__price">
                  {% if product.compare_at_price > product.price %}
                    <span class="product-card__price-sale">{{ product.price | money }}</span>
                    <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
                  {% else %}
                    <span class="product-card__price-regular">{{ product.price | money }}</span>
                  {% endif %}
                </div>
                {% if product.available %}
                  <div class="product-card__availability">In Stock</div>
                {% else %}
                  <div class="product-card__availability product-card__availability--out">Out of Stock</div>
                {% endif %}
              </div>
            </a>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% stylesheet %}
  .collection-page {
    padding: 2rem 0 4rem;
    background-color: var(--brand-background);
  }

  .collection-header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 0 var(--page-margin);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .collection-title {
    font-size: 2.5rem;
    color: var(--brand-text);
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .collection-description {
    font-size: 1.1rem;
    color: var(--brand-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .collection-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .collection-count {
    background-color: var(--brand-primary);
    color: var(--brand-background);
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .collection-products {
    padding: 0 var(--page-margin);
    max-width: 1200px;
    margin: 0 auto;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .product-card {
    background-color: var(--brand-background);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: all 0.3s ease;
    border: 1px solid rgba(0, 102, 204, 0.1);
  }

  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-color: var(--brand-primary);
  }

  .product-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .product-card__image-container {
    position: relative;
    width: 100%;
    height: 250px;
    overflow: hidden;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--brand-surface), var(--ocean-light));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-primary);
  }

  .product-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--brand-accent);
    color: var(--brand-background);
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product-card__content {
    padding: 1.5rem;
  }

  .product-card__title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--brand-text);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .product-card__price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .product-card__price-regular,
  .product-card__price-sale {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--brand-primary);
  }

  .product-card__price-compare {
    font-size: 0.9rem;
    color: var(--brand-text-muted);
    text-decoration: line-through;
  }

  .product-card__availability {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--brand-accent);
  }

  .product-card__availability--out {
    color: var(--brand-text-muted);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
  }

  .pagination a,
  .pagination span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--border-radius);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .pagination a {
    background-color: var(--brand-surface);
    color: var(--brand-text);
    border: 1px solid rgba(0, 102, 204, 0.2);
  }

  .pagination a:hover {
    background-color: var(--brand-primary);
    color: var(--brand-background);
    transform: translateY(-2px);
  }

  .pagination .current {
    background-color: var(--brand-primary);
    color: var(--brand-background);
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .collection-title {
      font-size: 2rem;
    }

    .collection-description {
      font-size: 1rem;
    }

    .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .product-card__image-container {
      height: 200px;
    }

    .product-card__content {
      padding: 1.25rem;
    }

    .product-card__title {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 480px) {
    .products-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .product-card__image-container {
      height: 180px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
