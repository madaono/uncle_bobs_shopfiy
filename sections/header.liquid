<header class="header">
  <div class="header__container">
    <div class="header__brand">
      <a href="{{ routes.root_url }}" class="header__logo">
        <img src="{{ 'logo_cir.png' | asset_url }}" alt="Uncle Bob's Logo" class="header__logo-img">
        <h1 class="header__title">Uncle Bob's</h1>
      </a>
    </div>

    <nav class="header__nav">
      <div class="header__menu">
        <a href="{{ routes.root_url }}" class="header__menu-link">Home</a>
        <a href="{{ routes.collections_url }}" class="header__menu-link">All Collections</a>
        <a href="{{ routes.all_products_collection_url }}" class="header__menu-link">All Products</a>
        <a href="{{ blogs.news.url }}" class="header__menu-link">Blog</a>
        <a href="/pages/about-us" class="header__menu-link">About Us</a>
      </div>
    </nav>

    <div class="header__actions">
      <div class="header__search-container">
        <button class="header__search-toggle" aria-label="Search" onclick="toggleSearch()">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
        <form action="{{ routes.search_url }}" method="get" class="header__search-form" role="search" id="searchForm">
          <input 
            type="search" 
            name="q" 
            placeholder="Search products..." 
            class="header__search-input"
            value="{{ search.terms | escape }}"
            id="searchInput"
          >
          <button type="submit" class="header__search-btn" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
          </button>
        </form>
      </div>

      {% if customer %}
        <div class="header__user-menu">
          <a href="{{ routes.account_url }}" class="header__icon header__account" aria-label="Account">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </a>
          <div class="header__user-dropdown">
            <a href="{{ routes.account_url }}" class="header__user-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              My Account
            </a>
            <a href="{{ routes.account_url }}/orders" class="header__user-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
              </svg>
              My Orders
            </a>
            <a href="{{ routes.account_logout_url }}" class="header__user-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16,17 21,12 16,7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              Logout
            </a>
          </div>
        </div>
      {% else %}
        <a href="{{ routes.account_login_url }}" class="header__icon header__login" aria-label="Login">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10,17 15,12 10,7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__icon header__cart" aria-label="Shopping Cart">
        <span class="header__cart-count" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
          {{ cart.item_count }}
        </span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="m1 1 4 4 13 1 4 8H6l-2 8"/>
        </svg>
      </a>
    </div>
  </div>
  
  <div class="header__banner {% if request.page_type == 'index' %}header__banner--home{% endif %}">
    {% if request.page_type == 'index' %}
      <p class="banner__text">Don't let the limited items listed in our store fool you; <span class="banner__emphasize">we have access to much more</span>. Thanks to our strong supply chain, we can source <span class="banner__highlight">anything</span> you need for fishing gear. Seriously, <span class="banner__highlight">anything</span>. Just contact us via phone, email, or message us on Facebook (Fb) for a detailed product list and quotation.</p>
    {% else %}
      <p>Free Shipping on Order Over $60</p>
    {% endif %}
  </div>
</header>

{% stylesheet %}
  .header {
    background: #1A2B40;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .header__brand {
    display: flex;
    align-items: center;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: white;
    transition: transform 0.3s ease;
  }

  .header__logo:hover {
    transform: scale(1.05);
  }

  .header__logo-img {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .header__logo:hover .header__logo-img {
    transform: rotate(5deg);
  }

  .header__title {
    font-size: 1.8rem;
    font-weight: 700;
    color: white;
    margin: 0;
    line-height: 1.2;
  }

  .header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header__menu {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .header__menu-link {
    color: white;
    text-decoration: none;
    font-weight: 600;
    padding: 0.5rem 0.8rem;
    transition: all 0.3s ease;
    position: relative;
    white-space: nowrap;
    font-size: 0.95rem;
  }

  .header__menu-link:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  /* Blog Dropdown Styles */
  .header__blog-dropdown {
    position: relative;
  }

  .header__blog-trigger {
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .header__blog-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: white;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    padding: 0.5rem 0;
    min-width: 220px;
    margin-top: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 1000;
  }

  .header__blog-dropdown:hover .header__blog-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .header__blog-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.2rem;
    color: #333;
    text-decoration: none;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    position: relative;
  }

  .header__blog-link:hover {
    background-color: #f8f9fa;
    color: #1A2B40;
  }

  .header__blog-link:not(:last-child) {
    border-bottom: 1px solid #e9ecef;
  }

  .header__blog-count {
    background-color: #1A2B40;
    color: white;
    border-radius: 12px;
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    min-width: 24px;
    text-align: center;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header__search-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header__search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
    border-radius: 50%;
    transition: all 0.3s ease;
  }

  .header__search-toggle:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: scale(1.1);
  }

  .header__search-form {
    position: absolute;
    top: 100%;
    right: 0;
    display: flex;
    align-items: center;
    background: white;
    border-radius: 25px;
    padding: 0.3rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    z-index: 1000;
    min-width: 300px;
  }

  .header__search-form.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__search-form:focus-within {
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.2);
  }

  .header__search-input {
    background: transparent;
    border: none;
    color: #333;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    width: 250px;
    outline: none;
  }

  .header__search-input::placeholder {
    color: #999;
  }

  .header__search-btn {
    background: transparent;
    border: none;
    color: #666;
    padding: 0.5rem;
    cursor: pointer;
    border-radius: 50%;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header__search-btn:hover {
    background: rgba(0, 0, 0, 0.1);
    color: #333;
    transform: scale(1.1);
  }

  .header__search-btn svg {
    width: 20px;
    height: 20px;
  }

  .header__user-menu {
    position: relative;
  }

  .header__user-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    background: white;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    padding: 0.5rem 0;
    min-width: 180px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    z-index: 1000;
  }

  .header__user-menu:hover .header__user-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__user-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    color: #333;
    text-decoration: none;
    font-size: 0.9rem;
    transition: background-color 0.2s ease;
  }

  .header__user-link:hover {
    background-color: #f5f5f5;
  }

  .header__user-link svg {
    width: 16px;
    height: 16px;
    color: #666;
  }

  .header__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: white;
    text-decoration: none;
    border-radius: 50%;
    transition: all 0.3s ease;
    position: relative;
  }

  .header__icon:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: scale(1.1);
  }

  .header__icon svg {
    width: 24px;
    height: 24px;
  }

  .header__cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background-color: #ff4444;
    color: white;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .header__banner {
    background: #1A2B40;
    text-align: center;
    padding: 0.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .header__banner p {
    color: white;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* Home page specific banner styling */
  .header__banner--home {
    padding: 1.2rem 2rem;
    background: linear-gradient(135deg, #1A2B40 0%, #2A3D54 100%);
    position: relative;
    overflow: hidden;
  }

  .header__banner--home::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #4A9EFF, transparent);
    animation: shimmer 3s infinite;
  }

  @keyframes shimmer {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  .header__banner--home .banner__text {
    max-width: 1200px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.88rem;
    line-height: 1.75;
    text-align: center;
    letter-spacing: 0.2px;
  }

  .banner__emphasize {
    color: #6BB6FF;
    font-weight: 600;
    font-style: italic;
    font-size: 1em;
    letter-spacing: 0.3px;
  }

  .banner__highlight {
    color: #FFD700;
    font-weight: 700;
    font-size: 1.05em;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-style: italic;
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.4);
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .header__container {
      flex-direction: column;
      gap: 0.5rem;
      padding: 0.8rem 1rem;
    }

    .header__nav {
      width: 100%;
      order: 2;
    }

    .header__menu {
      gap: 0.8rem;
      flex-wrap: wrap;
      justify-content: center;
      overflow-x: visible;
      -webkit-overflow-scrolling: touch;
    }

    .header__menu-link {
      padding: 0.4rem 0.6rem;
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    .header__brand {
      order: 1;
    }

    .header__logo-img {
      width: 32px;
      height: 32px;
    }

    .header__title {
      font-size: 1.4rem;
    }

    .header__actions {
      gap: 0.5rem;
      order: 3;
      align-self: flex-end;
    }

    .header__search-form {
      min-width: 250px;
    }

    .header__search-input {
      width: 200px;
      font-size: 0.8rem;
    }

    .header__user-dropdown {
      min-width: 160px;
    }

    .header__user-link {
      padding: 0.6rem 0.8rem;
      font-size: 0.85rem;
    }

    .header__blog-menu {
      min-width: 180px;
    }

    .header__blog-link {
      padding: 0.6rem 1rem;
      font-size: 0.85rem;
    }

    .header__blog-count {
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
    }

    .header__banner--home {
      padding: 1rem;
    }

    .header__banner--home .banner__text {
      font-size: 0.8rem;
      line-height: 1.65;
      padding: 0 0.5rem;
      letter-spacing: 0.15px;
    }

    .banner__emphasize {
      font-weight: 600;
    }

    .banner__highlight {
      font-size: 0.9em;
      letter-spacing: 0.4px;
    }
  }

  @media (max-width: 480px) {
    .header__container {
      padding: 0.6rem 0.8rem;
    }

    .header__menu {
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .header__menu-link {
      font-size: 0.8rem;
      padding: 0.3rem 0.4rem;
      flex-shrink: 0;
    }

    .header__logo-img {
      width: 28px;
      height: 28px;
    }

    .header__title {
      font-size: 1.2rem;
    }

    .header__icon {
      width: 35px;
      height: 35px;
    }

    .header__icon svg {
      width: 20px;
      height: 20px;
    }

    .header__search-form {
      min-width: 200px;
    }

    .header__search-input {
      width: 150px;
      font-size: 0.75rem;
    }

    .header__search-btn svg {
      width: 18px;
      height: 18px;
    }

    .header__user-dropdown {
      min-width: 140px;
    }

    .header__user-link {
      padding: 0.5rem 0.7rem;
      font-size: 0.8rem;
    }

    .header__blog-menu {
      min-width: 160px;
    }

    .header__blog-link {
      padding: 0.5rem 0.8rem;
      font-size: 0.8rem;
    }

    .header__blog-count {
      font-size: 0.65rem;
      padding: 0.1rem 0.4rem;
    }

    .header__banner--home {
      padding: 0.8rem;
    }

    .header__banner--home .banner__text {
      font-size: 0.75rem;
      line-height: 1.55;
      padding: 0;
      letter-spacing: 0.1px;
    }

    .banner__emphasize {
      font-weight: 600;
    }

    .banner__highlight {
      font-size: 0.85em;
      letter-spacing: 0.3px;
      text-shadow: 0 0 6px rgba(255, 215, 0, 0.3);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}

<script>
function toggleSearch() {
  const searchForm = document.getElementById('searchForm');
  const searchInput = document.getElementById('searchInput');
  
  if (searchForm.classList.contains('active')) {
    // Hide search form
    searchForm.classList.remove('active');
  } else {
    // Show search form and focus input
    searchForm.classList.add('active');
    setTimeout(() => {
      searchInput.focus();
    }, 100);
  }
}

// Close search form when clicking outside
document.addEventListener('click', function(event) {
  const searchContainer = document.querySelector('.header__search-container');
  const searchForm = document.getElementById('searchForm');
  
  if (!searchContainer.contains(event.target) && searchForm.classList.contains('active')) {
    searchForm.classList.remove('active');
  }
});

// Close search form when pressing Escape key
document.addEventListener('keydown', function(event) {
  if (event.key === 'Escape') {
    const searchForm = document.getElementById('searchForm');
    if (searchForm.classList.contains('active')) {
      searchForm.classList.remove('active');
    }
  }
});

// Blog dropdown functionality for mobile
document.addEventListener('DOMContentLoaded', function() {
  const blogDropdowns = document.querySelectorAll('.header__blog-dropdown');
  
  blogDropdowns.forEach(function(dropdown) {
    const trigger = dropdown.querySelector('.header__blog-trigger');
    
    // Toggle dropdown on click (for mobile)
    trigger.addEventListener('click', function(e) {
      if (window.innerWidth <= 768) {
        e.preventDefault();
        const menu = dropdown.querySelector('.header__blog-menu');
        const isOpen = menu.style.visibility === 'visible';
        
        // Close all other dropdowns
        blogDropdowns.forEach(function(otherDropdown) {
          if (otherDropdown !== dropdown) {
            const otherMenu = otherDropdown.querySelector('.header__blog-menu');
            otherMenu.style.opacity = '0';
            otherMenu.style.visibility = 'hidden';
          }
        });
        
        // Toggle current dropdown
        if (isOpen) {
          menu.style.opacity = '0';
          menu.style.visibility = 'hidden';
        } else {
          menu.style.opacity = '1';
          menu.style.visibility = 'visible';
        }
      }
    });
    
    // Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
      if (window.innerWidth <= 768) {
        if (!dropdown.contains(e.target)) {
          const menu = dropdown.querySelector('.header__blog-menu');
          menu.style.opacity = '0';
          menu.style.visibility = 'hidden';
        }
      }
    });
  });
});
</script>
