<header class="header">
  <div class="header__container">
    <div class="header__brand">
      <a href="{{ routes.root_url }}" class="header__logo">
        <h1 class="header__title">Uncle Bob's</h1>
      </a>
    </div>

    <nav class="header__nav">
      <div class="header__menu">
        <a href="{{ routes.root_url }}" class="header__menu-link">Home</a>
        <a href="{{ routes.collections_url }}" class="header__menu-link">All Collections</a>
        <a href="{{ routes.collections_url }}" class="header__menu-link">All Products</a>
        <a href="{{ routes.root_url }}#about" class="header__menu-link">About Us</a>
      </div>
    </nav>

    <div class="header__actions">
      <a href="#" class="header__icon" aria-label="Search">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="header__icon header__cart" aria-label="Shopping Cart">
        <span class="header__cart-count" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
          {{ cart.item_count }}
        </span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="m1 1 4 4 13 1 4 8H6l-2 8"/>
        </svg>
      </a>
    </div>
  </div>
  
  <div class="header__banner">
    <p>Free Shipping on Order Over $60</p>
  </div>
</header>

{% stylesheet %}
  .header {
    background: #1A2B40;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .header__brand {
    display: flex;
    align-items: center;
  }

  .header__logo {
    text-decoration: none;
    color: white;
    transition: transform 0.3s ease;
  }

  .header__logo:hover {
    transform: scale(1.05);
  }

  .header__title {
    font-size: 1.8rem;
    font-weight: 700;
    color: white;
    margin: 0;
    line-height: 1.2;
  }

  .header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header__menu {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .header__menu-link {
    color: white;
    text-decoration: none;
    font-weight: 600;
    padding: 0.5rem 0.8rem;
    transition: all 0.3s ease;
    position: relative;
    white-space: nowrap;
    font-size: 0.95rem;
  }

  .header__menu-link:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: white;
    text-decoration: none;
    border-radius: 50%;
    transition: all 0.3s ease;
    position: relative;
  }

  .header__icon:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: scale(1.1);
  }

  .header__icon svg {
    width: 24px;
    height: 24px;
  }

  .header__cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background-color: #ff4444;
    color: white;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .header__banner {
    background: #1A2B40;
    text-align: center;
    padding: 0.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .header__banner p {
    color: white;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .header__container {
      flex-wrap: nowrap;
      gap: 0.5rem;
      padding: 0.8rem 1rem;
    }

    .header__nav {
      flex: 1;
      min-width: 0;
    }

    .header__menu {
      gap: 0.8rem;
      flex-wrap: nowrap;
      justify-content: center;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .header__menu-link {
      padding: 0.4rem 0.6rem;
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    .header__title {
      font-size: 1.4rem;
    }

    .header__actions {
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .header__container {
      padding: 0.6rem 0.8rem;
    }

    .header__menu {
      gap: 0.5rem;
    }

    .header__menu-link {
      font-size: 0.8rem;
      padding: 0.3rem 0.4rem;
    }

    .header__title {
      font-size: 1.2rem;
    }

    .header__icon {
      width: 35px;
      height: 35px;
    }

    .header__icon svg {
      width: 20px;
      height: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
