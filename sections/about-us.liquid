{% comment %}
  About Us section for Uncle Bob's Shopify theme
  This section provides information about the company, mission, and values
{% endcomment %}

<div class="about-us">
  <div class="about-us__container">
    <!-- Hero Section -->
    <div class="about-us__hero">
      <h1 class="about-us__title">About Uncle Bob's</h1>
      <p class="about-us__subtitle">Your trusted partner for quality products and exceptional service</p>
    </div>

    <!-- Our Story Section -->
    <div class="about-us__story">
      <h2 class="about-us__section-title">Our Story</h2>
      <div class="about-us__content">
        <p>Founded with a passion for quality and customer satisfaction, Uncle Bob's has been serving customers with dedication and integrity. We believe in providing exceptional products and service that exceed expectations.</p>
        <p>Our journey began with a simple mission: to offer the best products at fair prices while maintaining the highest standards of customer service. Over the years, we've built lasting relationships with our customers and suppliers, creating a trusted network that benefits everyone involved.</p>
      </div>
    </div>

    <!-- Mission & Values Section -->
    <div class="about-us__mission">
      <h2 class="about-us__section-title">Our Mission & Values</h2>
      <div class="about-us__values">
        <div class="about-us__value">
          <h3>Quality First</h3>
          <p>We are committed to providing only the highest quality products to our customers.</p>
        </div>
        <div class="about-us__value">
          <h3>Customer Focus</h3>
          <p>Our customers are at the heart of everything we do. We strive to exceed their expectations.</p>
        </div>
        <div class="about-us__value">
          <h3>Trust & Reliability</h3>
          <p>We build lasting relationships through trust, reliability, and consistent service.</p>
        </div>
      </div>
    </div>

    <!-- Contact Section -->
    <div class="about-us__contact">
      <h2 class="about-us__section-title">Get In Touch</h2>
      <p class="about-us__contact-text">We'd love to hear from you. Contact us for any questions or feedback.</p>
      <div class="about-us__contact-actions">
        <a href="mailto:contact@unclebobs.com?subject=Contact%20Us&body=Hello%20Uncle%20Bob's%20Team,%0A%0AI%20would%20like%20to%20get%20in%20touch%20with%20you.%0A%0APlease%20let%20me%20know%20how%20I%20can%20reach%20you.%0A%0AThank%20you!" class="about-us__contact-btn">Contact Us</a>
        <a href="{{ routes.root_url }}" class="about-us__contact-btn about-us__contact-btn--secondary">Shop Now</a>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .about-us {
    background: #f8f9fa;
    min-height: 100vh;
  }

  .about-us__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .about-us__hero {
    text-align: center;
    margin-bottom: 4rem;
    padding: 3rem 0;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .about-us__title {
    font-size: 3rem;
    font-weight: 700;
    color: #1A2B40;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .about-us__subtitle {
    font-size: 1.2rem;
    color: #666;
    line-height: 1.6;
    margin: 0;
  }

  .about-us__hero-image {
    text-align: center;
  }

  .about-us__hero-image img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .about-us__story {
    margin-bottom: 4rem;
    padding: 3rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .about-us__section-title {
    font-size: 2.5rem;
    font-weight: 600;
    color: #1A2B40;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .about-us__text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #555;
  }

  .about-us__story-image {
    text-align: center;
  }

  .about-us__story-image img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .about-us__mission {
    margin-bottom: 4rem;
    padding: 3rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .about-us__values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .about-us__value {
    text-align: center;
    padding: 2rem;
    border-radius: 8px;
    background: #f8f9fa;
    transition: transform 0.3s ease;
  }

  .about-us__value:hover {
    transform: translateY(-5px);
  }

  .about-us__value h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #1A2B40;
    margin-bottom: 1rem;
  }

  .about-us__value p {
    color: #666;
    line-height: 1.6;
  }


  .about-us__contact {
    text-align: center;
    padding: 3rem;
    background: #1A2B40;
    color: white;
    border-radius: 12px;
  }

  .about-us__contact .about-us__section-title {
    color: white;
  }

  .about-us__contact-text {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .about-us__contact-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .about-us__contact-btn {
    display: inline-block;
    padding: 1rem 2rem;
    background: white;
    color: #1A2B40;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .about-us__contact-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  .about-us__contact-btn--secondary {
    background: transparent;
    color: white;
    border: 2px solid white;
  }

  .about-us__contact-btn--secondary:hover {
    background: white;
    color: #1A2B40;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .about-us__container {
      padding: 1rem;
    }

    .about-us__title {
      font-size: 2.5rem;
    }

    .about-us__story,
    .about-us__mission {
      padding: 2rem;
    }

    .about-us__values {
      grid-template-columns: 1fr;
    }

    .about-us__contact-actions {
      flex-direction: column;
      align-items: center;
    }

    .about-us__contact-btn {
      width: 100%;
      max-width: 300px;
    }
  }
{% endstylesheet %}

