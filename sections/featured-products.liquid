{% comment %}
  Uncle Bob's Featured Products Section
{% endcomment %}

<div id="featured-products" class="featured-products">
  <div class="featured-products__container">
    <div class="featured-products__header">
      <div class="featured-products__badge">Featured Products</div>
      <h2 class="featured-products__title">{{ section.settings.section_title | default: "Our Best Sellers" }}</h2>
      <p class="featured-products__subtitle">{{ section.settings.section_description | default: "Discover our most popular fishing gear and accessories" }}</p>
    </div>

    <div class="featured-products__grid">
      {% if section.settings.collection != blank %}
        {% assign collection = collections[section.settings.collection] %}
        {% assign products_to_show = section.settings.products_to_show | default: 8 %}
        
        {% for product in collection.products limit: products_to_show %}
          <div class="featured-product-card">
            <a href="{{ product.url }}" class="featured-product-card__link">
              <div class="featured-product-card__image-container">
                {% if product.featured_image %}
                  {% render 'image',
                    class: 'featured-product-card__image',
                    image: product.featured_image,
                    width: 300,
                    height: 300,
                    crop: 'center'
                  %}
                {% else %}
                  <div class="featured-product-card__placeholder">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21,15 16,10 5,21"/>
                    </svg>
                  </div>
                {% endif %}
                {% if product.compare_at_price > product.price %}
                  <div class="featured-product-card__badge">Sale</div>
                {% endif %}
              </div>

              <div class="featured-product-card__content">
                <h3 class="featured-product-card__title">{{ product.title }}</h3>
                <div class="featured-product-card__price">
                  {% if product.compare_at_price > product.price %}
                    <span class="featured-product-card__price-sale">{{ product.price | money }}</span>
                    <span class="featured-product-card__price-compare">{{ product.compare_at_price | money }}</span>
                  {% else %}
                    <span class="featured-product-card__price-regular">{{ product.price | money }}</span>
                  {% endif %}
                </div>
                {% if product.available %}
                  <div class="featured-product-card__availability">In Stock</div>
                {% else %}
                  <div class="featured-product-card__availability featured-product-card__availability--out">Out of Stock</div>
                {% endif %}
              </div>
            </a>
          </div>
        {% endfor %}
      {% else %}
        {% comment %} 如果没有选择collection，显示所有产品 {% endcomment %}
        {% for product in collections.all.products limit: 8 %}
          <div class="featured-product-card">
            <a href="{{ product.url }}" class="featured-product-card__link">
              <div class="featured-product-card__image-container">
                {% if product.featured_image %}
                  {% render 'image',
                    class: 'featured-product-card__image',
                    image: product.featured_image,
                    width: 300,
                    height: 300,
                    crop: 'center'
                  %}
                {% else %}
                  <div class="featured-product-card__placeholder">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21,15 16,10 5,21"/>
                    </svg>
                  </div>
                {% endif %}
                {% if product.compare_at_price > product.price %}
                  <div class="featured-product-card__badge">Sale</div>
                {% endif %}
              </div>

              <div class="featured-product-card__content">
                <h3 class="featured-product-card__title">{{ product.title }}</h3>
                <div class="featured-product-card__price">
                  {% if product.compare_at_price > product.price %}
                    <span class="featured-product-card__price-sale">{{ product.price | money }}</span>
                    <span class="featured-product-card__price-compare">{{ product.compare_at_price | money }}</span>
                  {% else %}
                    <span class="featured-product-card__price-regular">{{ product.price | money }}</span>
                  {% endif %}
                </div>
                {% if product.available %}
                  <div class="featured-product-card__availability">In Stock</div>
                {% else %}
                  <div class="featured-product-card__availability featured-product-card__availability--out">Out of Stock</div>
                {% endif %}
              </div>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="featured-products__cta">
      <a href="{{ routes.collections_url }}" class="btn btn-primary btn--large">
        <span>View All Products</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</div>

{% stylesheet %}
  .featured-products {
    padding: 6rem 0;
    background: var(--brand-background);
    position: relative;
    overflow: hidden;
  }

  .featured-products::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="fish" x="0" y="0" width="50" height="50" patternUnits="userSpaceOnUse"><path d="M25,10 Q35,5 45,10 Q35,15 25,10 M45,10 Q55,15 45,20 Q35,15 45,10" fill="rgba(0,102,204,0.03)"/></pattern></defs><rect width="100" height="100" fill="url(%23fish)"/></svg>') repeat;
    opacity: 0.5;
  }

  .featured-products__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--page-margin);
    position: relative;
    z-index: 2;
  }

  .featured-products__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .featured-products__badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--brand-primary), var(--brand-secondary));
    color: var(--brand-background);
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
  }

  .featured-products__title {
    font-size: 3rem;
    color: var(--brand-text);
    margin-bottom: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .featured-products__subtitle {
    font-size: 1.3rem;
    color: var(--brand-text-muted);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .featured-products__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .featured-product-card {
    background: var(--brand-background);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 102, 204, 0.1);
    transition: all 0.4s ease;
    border: 1px solid rgba(0, 102, 204, 0.1);
    overflow: hidden;
    position: relative;
  }

  .featured-product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--brand-primary), var(--brand-secondary));
  }

  .featured-product-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 20px 40px rgba(0, 102, 204, 0.15);
    border-color: var(--brand-primary);
  }

  .featured-product-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .featured-product-card__image-container {
    position: relative;
    width: 100%;
    height: 250px;
    overflow: hidden;
  }

  .featured-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .featured-product-card:hover .featured-product-card__image {
    transform: scale(1.05);
  }

  .featured-product-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--brand-surface), var(--ocean-light));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-primary);
  }

  .featured-product-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--brand-accent);
    color: var(--brand-background);
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .featured-product-card__content {
    padding: 2rem;
  }

  .featured-product-card__title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--brand-text);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .featured-product-card__price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .featured-product-card__price-regular,
  .featured-product-card__price-sale {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--brand-primary);
  }

  .featured-product-card__price-compare {
    font-size: 1rem;
    color: var(--brand-text-muted);
    text-decoration: line-through;
  }

  .featured-product-card__availability {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--brand-accent);
  }

  .featured-product-card__availability--out {
    color: var(--brand-text-muted);
  }

  .featured-products__cta {
    text-align: center;
  }

  .btn--large {
    padding: 1.2rem 3rem;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 50px;
    background: linear-gradient(135deg, var(--brand-primary), var(--brand-secondary));
    color: var(--brand-background);
    border: 2px solid transparent;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn--large:hover {
    background: var(--brand-background);
    color: var(--brand-primary);
    border-color: var(--brand-primary);
    transform: translateY(-3px);
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .featured-products__title {
      font-size: 2.5rem;
    }

    .featured-products__subtitle {
      font-size: 1.1rem;
    }

    .featured-products__grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .featured-product-card__content {
      padding: 1.5rem;
    }

    .featured-product-card__title {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .featured-products {
      padding: 4rem 0;
    }

    .featured-products__title {
      font-size: 2rem;
    }

    .featured-products__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .featured-product-card__content {
      padding: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Our Best Sellers"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "Discover our most popular fishing gear and accessories"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Choose a collection to display products from. If no collection is selected, all products will be shown."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products to show",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
