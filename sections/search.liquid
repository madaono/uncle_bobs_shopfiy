{% comment %}
  Enhanced search section with improved UI and functionality
  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<div class="search-page">
  <div class="search-page__header">
    <h1 class="search-page__title">{{ 'search.title' | t }}</h1>
    
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <div class="search-page__input-group">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search products, collections, and more..."
          class="search-page__input"
          autocomplete="off"
        >
        <button type="submit" class="search-page__button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          Search
        </button>
      </div>
    </form>
  </div>

  {% if search.performed %}
    <div class="search-page__results">
      {% if search.results_count == 0 %}
        <div class="search-page__no-results">
          <div class="search-page__no-results-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
          </div>
          <h2>No results found</h2>
          <p>We couldn't find anything matching "{{ search.terms | escape }}"</p>
          <div class="search-page__suggestions">
            <p>Try:</p>
            <ul>
              <li>Checking your spelling</li>
              <li>Using different keywords</li>
              <li>Using more general terms</li>
              <li>Browsing our <a href="{{ routes.collections_url }}">collections</a></li>
            </ul>
          </div>
        </div>
      {% else %}
        <div class="search-page__results-header">
          <h2>Search Results</h2>
          <p class="search-page__results-count">
            Found {{ search.results_count }} result{{ search.results_count | pluralize }} for "{{ search.terms | escape }}"
          </p>
        </div>

        <div class="search-page__filters">
          <div class="search-page__filter-group">
            <label>Filter by type:</label>
            <select class="search-page__filter" onchange="filterResults(this.value)">
              <option value="all">All Results</option>
              <option value="product">Products</option>
              <option value="article">Articles</option>
              <option value="page">Pages</option>
            </select>
          </div>
        </div>

        <div class="search-page__results-grid">
          {% paginate search.results by 12 %}
            {% for result in search.results %}
              <div class="search-result" data-type="{{ result.object_type }}">
                {% assign featured_image = result.featured_image | default: result.image %}
                <div class="search-result__image-container">
                  {% if featured_image %}
                    {% render 'image', class: 'search-result__image', image: featured_image, url: result.url, width: 300 %}
                  {% else %}
                    <div class="search-result__placeholder">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21,15 16,10 5,21"/>
                      </svg>
                    </div>
                  {% endif %}
                  {% if result.object_type == 'product' %}
                    <div class="search-result__badge">Product</div>
                  {% elsif result.object_type == 'article' %}
                    <div class="search-result__badge">Article</div>
                  {% else %}
                    <div class="search-result__badge">Page</div>
                  {% endif %}
                </div>
                
                <div class="search-result__content">
                  <h3 class="search-result__title">
                    <a href="{{ result.url }}">{{ result.title }}</a>
                  </h3>
                  
                  {% if result.object_type == 'product' %}
                    <div class="search-result__price">
                      {% if result.price %}
                        <span class="search-result__price-current">{{ result.price | money_with_currency }}</span>
                        {% if result.compare_at_price > result.price %}
                          <span class="search-result__price-compare">{{ result.compare_at_price | money_with_currency }}</span>
                        {% endif %}
                      {% endif %}
                    </div>
                    {% if result.vendor %}
                      <p class="search-result__vendor">by {{ result.vendor }}</p>
                    {% endif %}
                  {% elsif result.object_type == 'article' %}
                    <p class="search-result__excerpt">{{ result.excerpt | strip_html | truncate: 120 }}</p>
                    <p class="search-result__date">{{ result.published_at | date: '%B %d, %Y' }}</p>
                  {% else %}
                    <p class="search-result__excerpt">{{ result.content | strip_html | truncate: 120 }}</p>
                  {% endif %}
                </div>
              </div>
            {% endfor %}

            <div class="search-page__pagination">
              {{ paginate | default_pagination }}
            </div>
          {% endpaginate %}
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .search-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .search-page__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .search-page__title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #1A2B40;
    margin-bottom: 1.5rem;
  }

  .search-page__form {
    max-width: 600px;
    margin: 0 auto;
  }

  .search-page__input-group {
    display: flex;
    background: white;
    border-radius: 50px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    border: 2px solid #e1e5e9;
    transition: all 0.3s ease;
  }

  .search-page__input-group:focus-within {
    border-color: #1A2B40;
    box-shadow: 0 4px 25px rgba(26, 43, 64, 0.15);
  }

  .search-page__input {
    flex: 1;
    border: none;
    padding: 1rem 1.5rem;
    font-size: 1rem;
    outline: none;
    background: transparent;
  }

  .search-page__input::placeholder {
    color: #999;
  }

  .search-page__button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #1A2B40;
    color: white;
    border: none;
    padding: 1rem 2rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .search-page__button:hover {
    background: #2a3f5f;
    transform: translateY(-1px);
  }

  .search-page__results-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .search-page__results-header h2 {
    font-size: 2rem;
    color: #1A2B40;
    margin-bottom: 0.5rem;
  }

  .search-page__results-count {
    color: #666;
    font-size: 1.1rem;
  }

  .search-page__filters {
    margin-bottom: 2rem;
    display: flex;
    justify-content: center;
  }

  .search-page__filter-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .search-page__filter-group label {
    font-weight: 600;
    color: #1A2B40;
  }

  .search-page__filter {
    padding: 0.5rem 1rem;
    border: 2px solid #e1e5e9;
    border-radius: 8px;
    background: white;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .search-page__filter:focus {
    outline: none;
    border-color: #1A2B40;
  }

  .search-page__results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .search-result {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    position: relative;
  }

  .search-result:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .search-result__image-container {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .search-result__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .search-result:hover .search-result__image {
    transform: scale(1.05);
  }

  .search-result__placeholder {
    width: 100%;
    height: 100%;
    background: #f8f9fa;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
  }

  .search-result__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #1A2B40;
    color: white;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .search-result__content {
    padding: 1.5rem;
  }

  .search-result__title {
    margin-bottom: 0.5rem;
  }

  .search-result__title a {
    color: #1A2B40;
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .search-result__title a:hover {
    color: #2a3f5f;
  }

  .search-result__price {
    margin-bottom: 0.5rem;
  }

  .search-result__price-current {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1A2B40;
  }

  .search-result__price-compare {
    text-decoration: line-through;
    color: #999;
    margin-left: 0.5rem;
  }

  .search-result__vendor {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .search-result__excerpt {
    color: #666;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .search-result__date {
    color: #999;
    font-size: 0.9rem;
  }

  .search-page__no-results {
    text-align: center;
    padding: 4rem 2rem;
  }

  .search-page__no-results-icon {
    color: #ccc;
    margin-bottom: 2rem;
  }

  .search-page__no-results h2 {
    font-size: 2rem;
    color: #1A2B40;
    margin-bottom: 1rem;
  }

  .search-page__no-results p {
    color: #666;
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .search-page__suggestions {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .search-page__suggestions p {
    font-weight: 600;
    color: #1A2B40;
    margin-bottom: 1rem;
  }

  .search-page__suggestions ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .search-page__suggestions li {
    padding: 0.5rem 0;
    color: #666;
  }

  .search-page__suggestions a {
    color: #1A2B40;
    text-decoration: none;
    font-weight: 600;
  }

  .search-page__suggestions a:hover {
    text-decoration: underline;
  }

  .search-page__pagination {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .search-page {
      padding: 1rem;
    }

    .search-page__title {
      font-size: 2rem;
    }

    .search-page__input-group {
      flex-direction: column;
      border-radius: 12px;
    }

    .search-page__button {
      border-radius: 0 0 10px 10px;
    }

    .search-page__results-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .search-page__filters {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}

<script>
function filterResults(type) {
  const results = document.querySelectorAll('.search-result');
  
  results.forEach(result => {
    if (type === 'all' || result.dataset.type === type) {
      result.style.display = 'block';
    } else {
      result.style.display = 'none';
    }
  });
}

// Add smooth scrolling for better UX
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.querySelector('.search-page__input');
  if (searchInput) {
    searchInput.focus();
  }
});
</script>
