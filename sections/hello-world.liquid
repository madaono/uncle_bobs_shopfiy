{% comment %}
  Uncle Bob's Homepage Hero Section
{% endcomment %}

<div class="hero full-width">
  <div class="hero__background">
    <img src="{{ 'banner.png' | asset_url }}" alt="Fishing Adventure" class="hero__image">
    <div class="hero__overlay"></div>
  </div>
  
  <div class="hero__content">
    <div class="hero__text">
      <h1 class="hero__title">Welcome to Uncle Bob's</h1>
      <p class="hero__subtitle">Premium Fishing Experience</p>
      <p class="hero__description">
        Through quality products, we help you achieve an enjoyable fishing experience. 
        Discover our premium fishing gear, tackle, and accessories designed for the serious angler.
      </p>
      <div class="hero__actions">
        <a href="{{ routes.collections_url }}" class="btn btn-primary">Shop Now</a>
        <a href="#featured-products" class="btn btn-secondary">Explore Products</a>
      </div>
    </div>
  </div>
</div>

<div class="features">
  <div class="features__container">
    <div class="features__header">
      <h2>Why Choose Uncle Bob's?</h2>
      <p>We're committed to providing the best fishing experience with premium quality products</p>
    </div>
    
    <div class="features__grid">
      <div class="feature-card">
        <div class="feature-card__icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <h3>Premium Quality</h3>
        <p>Only the finest fishing gear and accessories, tested by professionals and trusted by anglers worldwide.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-card__icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
        </div>
        <h3>Expert Knowledge</h3>
        <p>Years of fishing experience and expertise to guide you to the best products for your needs.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-card__icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27,6.96 12,12.01 20.73,6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </div>
        <h3>Fast Shipping</h3>
        <p>Quick and reliable delivery to get your fishing gear to you when you need it most.</p>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 102, 204, 0.8) 0%, rgba(77, 157, 224, 0.6) 100%);
    z-index: 2;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: var(--brand-background);
    max-width: 800px;
    padding: 0 2rem;
  }

  .hero__title {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  }

  .hero__subtitle {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ocean-light);
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  .hero__description {
    font-size: 1.2rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
  }

  .hero__actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero__actions .btn {
    padding: 1rem 2rem;
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .features {
    padding: 4rem 0;
    background-color: var(--brand-surface);
  }

  .features__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .features__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .features__header h2 {
    font-size: 2.5rem;
    color: var(--brand-text);
    margin-bottom: 1rem;
  }

  .features__header p {
    font-size: 1.2rem;
    color: var(--brand-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    background-color: var(--brand-background);
    padding: 2.5rem 2rem;
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition: all 0.3s ease;
    border: 1px solid rgba(0, 102, 204, 0.1);
  }

  .feature-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-color: var(--brand-primary);
  }

  .feature-card__icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    background: linear-gradient(135deg, var(--brand-primary), var(--brand-secondary));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-background);
  }

  .feature-card h3 {
    font-size: 1.5rem;
    color: var(--brand-text);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .feature-card p {
    color: var(--brand-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .hero {
      height: 60vh;
      min-height: 400px;
    }

    .hero__title {
      font-size: 2.5rem;
    }

    .hero__subtitle {
      font-size: 1.2rem;
    }

    .hero__description {
      font-size: 1rem;
    }

    .hero__actions {
      flex-direction: column;
      align-items: center;
    }

    .hero__actions .btn {
      width: 200px;
    }

    .features__header h2 {
      font-size: 2rem;
    }

    .features__header p {
      font-size: 1rem;
    }

    .features__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .feature-card {
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      font-size: 2rem;
    }

    .hero__subtitle {
      font-size: 1rem;
    }

    .hero__content {
      padding: 0 1rem;
    }

    .feature-card__icon {
      width: 60px;
      height: 60px;
    }

    .feature-card h3 {
      font-size: 1.3rem;
    }
  }
{% endstylesheet %}

