<footer class="footer">
  <div class="footer__container">
    <div class="footer__brand">
      <h3 class="footer__title">Uncle Bob's</h3>
      <img src="{{ 'footLogo.png' | asset_url }}" alt="Uncle Bob's Footer Logo" class="footer__logo">
    </div>

    <div class="footer__links">
      <div class="footer__section">
        <h4 class="footer__section-title">Shop</h4>
        <ul class="footer__menu">
          {% for collection in collections limit: 3 %}
            <li><a href="{{ collection.url }}" class="footer__link">{{ collection.title }}</a></li>
          {% endfor %}
          <li><a href="{{ routes.collections_url }}" class="footer__link">All Products</a></li>
        </ul>
      </div>

      <div class="footer__section">
        <h4 class="footer__section-title">Support</h4>
        <ul class="footer__menu">
          <li><a href="mailto:contact@unclebobs.com?subject=Contact%20Us&body=Hello%20Uncle%20Bob's%20Team,%0A%0AI%20would%20like%20to%20get%20in%20touch%20with%20you.%0A%0APlease%20let%20me%20know%20how%20I%20can%20reach%20you.%0A%0AThank%20you!" class="footer__link">Contact Us</a></li>
        </ul>
      </div>

      <div class="footer__section">
        <h4 class="footer__section-title">Company</h4>
        <ul class="footer__menu">
          <li><a href="/pages/about-us" class="footer__link">About Us</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__social">
      <a href="#" class="footer__social-link" aria-label="Facebook">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      </a>
      <a href="#" class="footer__social-link" aria-label="Instagram">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 6.62 5.367 11.987 11.988 11.987s11.987-5.367 11.987-11.987C24.004 5.367 18.637.001 12.017.001zM8.449 16.988c-1.297 0-2.448-.49-3.323-1.297C4.198 14.816 3.708 13.665 3.708 12.368s.49-2.448 1.297-3.323c.875-.807 2.026-1.297 3.323-1.297s2.448.49 3.323 1.297c.807.875 1.297 2.026 1.297 3.323s-.49 2.448-1.297 3.323c-.875.807-2.026 1.297-3.323 1.297zm7.718-1.297c-.875.807-2.026 1.297-3.323 1.297s-2.448-.49-3.323-1.297c-.807-.875-1.297-2.026-1.297-3.323s.49-2.448 1.297-3.323c.875-.807 2.026-1.297 3.323-1.297s2.448.49 3.323 1.297c.807.875 1.297 2.026 1.297 3.323s-.49 2.448-1.297 3.323z"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__bottom-container">
      <div class="footer__copyright">
        <p>&copy; 2024 Uncle Bob's All Rights Reserved.</p>
      </div>
      <div class="footer__decoration">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    background: #1A2B40;
    color: white;
    margin-top: 4rem;
  }

  .footer__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer__brand {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .footer__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin: 0;
  }

  .footer__logo {
    width: 80px;
    height: 80px;
    object-fit: contain;
    transition: transform 0.3s ease;
    opacity: 0.9;
  }

  .footer__logo:hover {
    transform: scale(1.05);
    opacity: 1;
  }

  .footer__links {
    display: flex;
    gap: 4rem;
    flex: 2;
  }

  .footer__section {
    flex: 1;
  }

  .footer__section-title {
    font-size: 1rem;
    font-weight: 600;
    color: white;
    margin-bottom: 1rem;
  }

  .footer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__menu li {
    margin-bottom: 0.5rem;
  }

  .footer__link {
    color: white;
    text-decoration: none;
    transition: color 0.3s ease;
    display: block;
    padding: 0.25rem 0;
    font-size: 0.9rem;
  }

  .footer__link:hover {
    color: #87ceeb;
    text-decoration: underline;
  }

  .footer__social {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .footer__social-link {
    color: white;
    text-decoration: none;
    padding: 0.5rem;
    border-radius: 50%;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
  }

  .footer__social-link:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: scale(1.1);
  }

  .footer__social-link svg {
    width: 20px;
    height: 20px;
  }

  .footer__bottom {
    background-color: #1A2B40;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__bottom-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer__copyright p {
    color: white;
    margin: 0;
    font-size: 0.9rem;
  }

  .footer__decoration {
    color: white;
    opacity: 0.7;
  }

  .footer__decoration svg {
    width: 20px;
    height: 20px;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .footer__container {
      flex-direction: column;
      gap: 2rem;
      padding: 2rem 1rem;
    }

    .footer__links {
      flex-direction: column;
      gap: 2rem;
    }

    .footer__brand {
      align-items: center;
      text-align: center;
    }

    .footer__logo {
      width: 60px;
      height: 60px;
    }

    .footer__social {
      justify-content: center;
    }

    .footer__bottom-container {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
      padding: 1rem;
    }
  }

  @media (max-width: 480px) {
    .footer__links {
      gap: 1.5rem;
    }

    .footer__section-title {
      font-size: 0.9rem;
    }

    .footer__link {
      font-size: 0.8rem;
    }

    .footer__social-link {
      width: 35px;
      height: 35px;
    }

    .footer__logo {
      width: 50px;
      height: 50px;
    }

    .footer__social-link svg {
      width: 18px;
      height: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
