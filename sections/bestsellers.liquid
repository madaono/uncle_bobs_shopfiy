{% comment %}
  Uncle Bob's Best Sellers Section
{% endcomment %}

<div class="bestsellers">
  <div class="bestsellers__container">
    <div class="bestsellers__header">
      <h2 class="bestsellers__title">Our Best Sellers</h2>
    </div>

    <div class="bestsellers__grid">
      {% for product in collections.all.products limit: 4 %}
        <div class="product-card">
          <a href="{{ product.url }}" class="product-card__link">
            <div class="product-card__image-container">
              {% if product.featured_image %}
                {% render 'image',
                  class: 'product-card__image',
                  image: product.featured_image,
                  width: 300,
                  height: 200,
                  crop: 'center'
                %}
              {% else %}
                <img src="{{ 'bobFishing.png' | asset_url }}" alt="{{ product.title }}" class="product-card__image">
              {% endif %}
            </div>
            <div class="product-card__content">
              <h3 class="product-card__title">{{ product.title }}</h3>
              <div class="product-card__price">
                {% if product.compare_at_price > product.price %}
                  <span class="product-card__price-sale">{{ product.price | money }}</span>
                  <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
                {% else %}
                  {{ product.price | money }}
                {% endif %}
              </div>
              {% if product.available %}
                <div class="product-card__rating">
                  <span class="product-card__stars">★★★★★</span>
                  <span class="product-card__reviews">In Stock</span>
                </div>
              {% else %}
                <div class="product-card__rating">
                  <span class="product-card__stars">★★★★★</span>
                  <span class="product-card__reviews">Out of Stock</span>
                </div>
              {% endif %}
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .bestsellers {
    background-color: #F5F5F5;
    padding: 4rem 0;
  }

  .bestsellers__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .bestsellers__header {
    margin-bottom: 3rem;
  }

  .bestsellers__title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #2c3e50;
    margin-bottom: 1rem;
    text-align: left;
  }

  .bestsellers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .product-card {
    background-color: white;
    border-radius: 12px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .product-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }

  .product-card__image-container {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__content {
    padding: 1.5rem;
  }

  .product-card__title {
    font-size: 1rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 0.8rem;
    line-height: 1.4;
  }

  .product-card__price {
    font-size: 1.2rem;
    font-weight: 700;
    color: #2c3e50;
    margin-bottom: 0.8rem;
  }

  .product-card__price-sale {
    color: #e74c3c;
    font-weight: 700;
  }

  .product-card__price-compare {
    color: #95a5a6;
    text-decoration: line-through;
    font-size: 1rem;
    margin-left: 0.5rem;
  }

  .product-card__rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .product-card__stars {
    color: #ffc107;
    font-size: 0.9rem;
  }

  .product-card__reviews {
    font-size: 0.8rem;
    color: #6c757d;
  }

  .product-card__add-to-cart {
    background-color: #2196F3;
    color: white;
    border: none;
    padding: 0.8rem 1.5rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
  }

  .product-card__add-to-cart:hover {
    background-color: #1976D2;
    transform: translateY(-2px);
  }

  /* Mobile responsiveness */
  @media (max-width: 1024px) {
    .bestsellers__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .bestsellers {
      padding: 3rem 0;
    }

    .bestsellers__container {
      padding: 0 1rem;
    }

    .bestsellers__title {
      font-size: 2rem;
    }

    .bestsellers__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .product-card__image-container {
      height: 180px;
    }

    .product-card__content {
      padding: 1rem;
    }

    .product-card__title {
      font-size: 0.9rem;
    }

    .product-card__price {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 480px) {
    .bestsellers__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .product-card__image-container {
      height: 160px;
    }

    .product-card__content {
      padding: 0.8rem;
    }

    .product-card__title {
      font-size: 0.8rem;
    }

    .product-card__price {
      font-size: 1rem;
    }

    .product-card__add-to-cart {
      padding: 0.6rem 1rem;
      font-size: 0.8rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Best Sellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Best Sellers"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
